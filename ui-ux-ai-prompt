اینپوت‌ها و فرم‌ها
استایل پایه
css
input,
textarea,
select {

    width: 100%;

    padding: 14px 16px;

    background: var(--card-bg);

    backdrop-filter: blur(20px);

    border: 1px solid var(--border-color);

    border-radius: 12px;

    color: var(--text-primary);

    font-size: 15px;

    transition: all 0.3s ease;

    outline: none;
}
placeholder

css
input::placeholder,
textarea::placeholder {
    color: var(--text-muted);
}
Focus State
css
input:focus,
textarea:focus,
select:focus {

    border-color: var(--accent-color);

    box-shadow: 0 0 0 3px rgba(14,165,233,0.1);

}
Error State
css
input.error {
    border-color: var(--error-color);
}
Success State
css
input.success {
    border-color: var(--success-color);
}
دکمه‌ها
Primary Button
css
.btn-primary {

    padding: 14px 28px;

    background: linear-gradient(
        135deg,
        var(--accent-color),
        var(--accent-hover)
    );

    color: white;

    border: none;

    border-radius: 12px;

    font-weight: 600;

    cursor: pointer;

    transition: all 0.3s ease;

    box-shadow: 0 8px 16px -4px var(--glow-color);
}
hover

css
.btn-primary:hover {

    transform: translateY(-2px);

    box-shadow: 0 12px 24px -8px var(--glow-color);

}
کارت‌ها (Cards)
css
.card {

    background: var(--card-bg);

    backdrop-filter: blur(20px);

    padding: 24px;

    border-radius: 16px;

    border: 1px solid var(--border-color);

    box-shadow: 0 25px 50px -12px var(--shadow-color);

    transition: all 0.3s ease;
}
hover

css
.card:hover {

    transform: translateY(-4px);

    border-color: var(--accent-color);

}
